# ─────────────────────────────────────────────────────────────
# QuillVault — Docker Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.docker .env
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_NAME=QuillVault API
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database (Docker defaults — matches docker-compose.yml) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quillvault
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/quillvault

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_EVENTS=true
CELERY_CONCURRENCY=1
CELERY_POOL=prefork

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Storage ──────────────────────────────────────────────────
AUDIO_STORAGE_PATH=/app/data/audio
MAX_AUDIO_SIZE_MB=2048

# ── ML Models ────────────────────────────────────────────────
# Whisper transcription
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=float32

# Speaker diarization (requires HuggingFace token)
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Embedding
EMBEDDING_SIMILARITY_THRESHOLD=0.30

# ── LLM (LangChain / OpenRouter) ────────────────────────────
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_TOKENS=4096

# ── Email ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── URLs ─────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── GPU Presets ──────────────────────────────────────────────
# Copy from backend/deploy/ or set manually:
#   1080 Ti:  WHISPER_DEVICE=cuda  WHISPER_COMPUTE_TYPE=int8
#   3060 Ti:  WHISPER_DEVICE=cuda  WHISPER_COMPUTE_TYPE=float16
#   CPU only: WHISPER_DEVICE=cpu   WHISPER_COMPUTE_TYPE=float32
# See DOCKER.md for full GPU compatibility table.

# ── Docker-specific ──────────────────────────────────────────
# Docker Hub username (used by docker-compose.server.yml to pull the image)
DOCKER_USER=yourusername
TAG=latest

# Service type: api | celery | all
# In docker-compose, api and celery run in separate containers.
# Only change this if running a single container manually.
SERVICE_TYPE=all
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=info

# Run alembic migrations on container start
RUN_MIGRATIONS=true

# Seed database with templates + test users on startup
SEED_DB=true
