# App
DEBUG=true
CORS_ORIGINS=["*"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quillvault

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Storage
AUDIO_STORAGE_PATH=./data/audio
MAX_AUDIO_SIZE_MB=2048

# Models
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=float32
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=
EMBEDDING_SIMILARITY_THRESHOLD=0.30

# LLM (OpenRouter free tier by default)
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_TOKENS=4096

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

BACKEND_URL=http://localhost:8000
