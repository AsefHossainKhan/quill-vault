# ─────────────────────────────────────────────────────────────
# QuillVault — CPU Only Preset
# ─────────────────────────────────────────────────────────────
# No GPU required. Slower but works everywhere.
# Consider using a smaller model for acceptable speed.
# ─────────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=float32
